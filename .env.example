# ==============================================================================
# PUMPKIN PANIC.IO - Root Environment Configuration Example
# ==============================================================================

# Server Network Port
PORT=2567

# Runtime Environment
NODE_ENV=production

# CORS allowed origins (set to '*' or your game host portal)
CORS_ORIGIN=*

# Match Capacity & Roster
TARGET_MATCH_PLAYERS=16
MAX_ROOM_CLIENTS=16

# Simulation Physics Rate (ticks per second)
SIMULATION_TICK_RATE=25

# Storm Hazard Damage Percent Per Second (0.07 = 7%/s)
STORM_DAMAGE_PERCENT=0.07
