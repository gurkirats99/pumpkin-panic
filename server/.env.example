# ==============================================================================
# PUMPKIN PANIC.IO Multiplayer Server Environment Configuration
# ==============================================================================

# Server Network Port (HTTP health check & WebSocket transport)
PORT=2567

# Runtime Environment ('development' | 'production')
NODE_ENV=production

# Cross-Origin Resource Sharing (CORS)
# For production, set to your frontend domain or allow CrazyGames portals:
# CORS_ORIGIN=https://*.crazygames.com,https://*.crazygames.net
CORS_ORIGIN=*

# Match Capacity & Roster
TARGET_MATCH_PLAYERS=16
MAX_ROOM_CLIENTS=16

# Simulation Physics Rate (ticks per second)
# 25 updates/sec = 40ms tick interval
SIMULATION_TICK_RATE=25

# Storm Shrinking & Hazard Damage
# Percentage of maximum health dealt per second outside the safe zone (0.07 = 7%/sec)
STORM_DAMAGE_PERCENT=0.07
